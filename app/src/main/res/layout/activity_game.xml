<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Thanh trên -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCauSo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Câu 1/10"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"/>

            <TextView
                android:id="@+id/tvThoiGian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 10"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"/>

        </LinearLayout>

        <!-- Điểm -->

        <TextView
            android:id="@+id/tvDiem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Điểm: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1565C0"/>

        <!-- Hình ảnh -->

        <ImageView
            android:id="@+id/imgQuocGia"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="15dp"
            android:scaleType="centerCrop"
            android:src="@drawable/vietnam"
            android:contentDescription="Hình ảnh quốc gia"/>

        <!-- Câu hỏi -->

        <TextView
            android:id="@+id/tvCauHoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Địa danh này thuộc quốc gia nào?"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#172B4D"/>

        <!-- Đáp án A -->

        <Button
            android:id="@+id/btnDapAnA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="A. Việt Nam"
            android:textSize="16sp"/>

        <!-- Đáp án B -->

        <Button
            android:id="@+id/btnDapAnB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="B. Nhật Bản"
            android:textSize="16sp"/>

        <!-- Đáp án C -->

        <Button
            android:id="@+id/btnDapAnC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="C. Pháp"
            android:textSize="16sp"/>

        <!-- Đáp án D -->

        <Button
            android:id="@+id/btnDapAnD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="D. Mỹ"
            android:textSize="16sp"/>

        <!-- Kết quả -->

        <TextView
            android:id="@+id/tvKetQua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1565C0"/>

        <!-- Giới thiệu quốc gia -->

        <TextView
            android:id="@+id/tvGioiThieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:text=""
            android:textSize="16sp"
            android:textColor="#333333"/>

        <!-- Câu tiếp -->

        <Button
            android:id="@+id/btnCauTiep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CÂU TIẾP THEO"
            android:textStyle="bold"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>