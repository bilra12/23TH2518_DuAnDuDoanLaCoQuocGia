<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#EAF6FF">

    <TextView
        android:id="@+id/tvTieuDe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌎 DỰ ĐOÁN QUỐC GIA"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvMoTa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhìn hình ảnh - Chọn quốc gia - Nhận điểm"
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnBatDau"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🎮  BẮT ĐẦU CHƠI"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnKyLuc"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🏆  KỶ LỤC"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnCaiDat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⚙  CÀI ĐẶT"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnHuongDan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📖  HƯỚNG DẪN"
        android:textSize="18sp"/>

</LinearLayout>