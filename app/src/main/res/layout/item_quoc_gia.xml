<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgQuocGia"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_launcher_foreground"
        android:scaleType="centerCrop"
        android:contentDescription="Hình ảnh quốc gia" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/txtTenQuocGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Việt Nam"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginBottom="5dp" />

        <TextView
            android:id="@+id/txtThuDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thủ đô: Hà Nội"
            android:textSize="15sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/txtChauLuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Châu lục: Châu Á"
            android:textSize="15sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/txtDacDiem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đặc điểm: Nổi tiếng với văn hóa..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>