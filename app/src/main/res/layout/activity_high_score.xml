<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#EAF6FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆 KỶ LỤC"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:layout_marginBottom="30dp" />

    <TextView
        android:id="@+id/tvKyLuc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏆 KỶ LỤC CỦA BẠN&#10;&#10;0 điểm"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:gravity="center"
        android:padding="25dp"
        android:background="#FFFFFF" />

    <Button
        android:id="@+id/btnXoaKyLuc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ XÓA KỶ LỤC"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp" />

    <Button
        android:id="@+id/btnTrangChu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏠 VỀ TRANG CHỦ"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp" />

</LinearLayout>